---
/**
 * Site footer with copyright, contact details, social links and the colour credit.
 */
interface Props {
  siteName: string;
}

const { siteName } = Astro.props;
const year = new Date().getFullYear();
const email = 'marcus.hanninen@gmail.com';
const socials = [{ label: 'LinkedIn', href: 'https://www.linkedin.com/in/marcus-h%C3%A4nninen/' }];
---

<footer class="wrap label site-footer" id="contact">
  <span>© {year} {siteName}</span>
  <ul class="links">
    <li class="email">
      <a href={`mailto:${email}`}>{email}</a>
      <button type="button" class="copy" data-copy={email}>Copy</button>
    </li>
    {
      socials.map((social) => (
        <li>
          <a href={social.href} target="_blank" rel="noopener">
            {social.label} ↗
          </a>
        </li>
      ))
    }
  </ul>
  <span>Colour: Sanzo Wada, No. 179</span>
</footer>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((button) => {
    const label = button.textContent;
    button.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(button.dataset.copy ?? '');
        button.textContent = 'Copied';
      } catch {
        button.textContent = 'Copy failed';
      }
      setTimeout(() => (button.textContent = label), 1600);
    });
  });
</script>

<style>
  .site-footer {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    padding-block: 1.25rem;
    border-top: 1px solid var(--line);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.75rem 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .email {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
  }

  .email a {
    text-transform: none;
    letter-spacing: 0.02em;
  }

  a {
    color: var(--fg);
    text-decoration: none;
  }

  a:hover {
    color: var(--accent);
  }

  .copy {
    border: 1px solid var(--line);
    border-radius: 999px;
    background: none;
    padding: 0.125rem 0.5rem;
    font: inherit;
    letter-spacing: inherit;
    text-transform: inherit;
    color: var(--fg-2);
    cursor: pointer;
  }

  .copy:hover {
    border-color: var(--fg);
    color: var(--fg);
  }
</style>
