---
/**
 * Opening section: name as oversized display type, with three short facts below.
 */
const companies = {
  hedera: 'https://www.linkedin.com/company/hedera-dx/',
  elekta: 'https://www.linkedin.com/company/elekta/',
  komu: 'https://www.linkedin.com/company/komuhomes/',
};
---

<section class="wrap hero" aria-label="Introduction">
  <h1 class="display">Marcus<br />Hänninen</h1>
  <p class="statement">
    I join startups early and build software for fields where complexity is a given.
    <span>
      My work starts before the first line of code: picking the stack, shaping how the team
      builds and ships, and working out with founders and domain experts what the product should
      be. At Hedera Dx that took cancer testing software from a pilot to a certified medical
      device.
    </span>
    <span>
      Currently at <a href={companies.hedera} target="_blank" rel="noopener">Hedera Dx</a>, heading
      for Series B. Previously at Kaiku Health,
      acquired by <a href={companies.elekta} target="_blank" rel="noopener">Elekta</a>, and co-founder
      &amp; CTO of <a href={companies.komu} target="_blank" rel="noopener">Komu Homes</a>.
    </span>
  </p>
  <div class="meta">
    <div>
      <div class="label">Discipline</div>
      <p>Founding engineer</p>
    </div>
    <div>
      <div class="label">Based in</div>
      <p>Helsinki · Remote</p>
    </div>
    <div>
      <div class="label">Title</div>
      <p>Senior Software Engineer</p>
    </div>
  </div>
</section>

<style>
  .hero {
    container-type: inline-size;
    display: grid;
    gap: clamp(1.75rem, 3.5vw, 3rem);
    padding-block: clamp(3rem, 9vw, 7rem) var(--section-space);
  }

  .statement {
    margin: 0;
    max-width: 28ch;
    font-size: var(--t-h2);
    font-weight: var(--display-weight);
    letter-spacing: calc(var(--display-track) * 0.5);
    line-height: 1.1;
    text-wrap: balance;
  }

  .statement span {
    display: block;
    margin-top: 1.25rem;
    max-width: 52ch;
    font-size: var(--t-body);
    font-weight: 400;
    letter-spacing: 0;
    line-height: 1.5;
    color: var(--fg-2);
  }

  .statement a {
    color: var(--fg);
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
    transition: color 0.2s;
  }

  .statement a:hover {
    color: var(--accent);
  }

  .meta {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    gap: 1.5rem 2rem;
    margin-top: clamp(1rem, 4vw, 3.5rem);
    padding-top: 1rem;
    border-top: 1px solid var(--line);
  }

  .meta p {
    margin: 0.375rem 0 0;
    max-width: 34ch;
  }
</style>
