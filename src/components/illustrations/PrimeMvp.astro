---
/**
 * Hedera Prime MVP: a barcoded sample tube, sequenced into DNA, turned into a signed clinical
 * report with ranked therapy options.
 */
const modules = [2, 1, 1, 1, 3, 1, 1, 2, 2, 1, 1, 1, 4, 1, 1, 2, 1, 1, 3, 1, 2, 1, 1, 1, 2];
let edge = 138;
const bars = modules
  .map((m) => {
    const bar = { y: edge, h: m * 1.4 };
    edge += bar.h;
    return bar;
  })
  .filter((_, i) => i % 2 === 0);
const helixY = Array.from({ length: 25 }, (_, i) => 165 + i * 2.5);
const strand = (sign: number) =>
  helixY.map((y) => `${(164 + sign * 12 * Math.cos((Math.PI * (y - 165)) / 30)).toFixed(1)},${y}`).join(' ');
const rungs = [165, 172.5, 187.5, 195, 202.5, 217.5, 225].map((y) => ({
  y,
  half: Math.abs(12 * Math.cos((Math.PI * (y - 165)) / 30)),
}));
const therapies = [
  { y: 210, w: 46, dot: 'i-r', evidence: 3 },
  { y: 228, w: 34, dot: 'i-y', evidence: 2 },
  { y: 246, w: 40, dot: 'i-y', evidence: 1 },
];
